{
  "name": "lgtm",
  "version": "0.1.0",
  "description": "👍 Looks Good To Me — dev productivity platform — a dev productivity platform with plugins",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/plugins/*"
  ],
  "bin": {
    "lgtm": "./packages/core/src/index.ts"
  },
  "scripts": {
    "dev": "bun run packages/core/src/index.ts",
    "build": "bun scripts/build.ts",
    "build:binary": "bun scripts/build.ts",
    "build:binary:linux-x64": "bun scripts/build.ts --target linux-x64",
    "build:binary:linux-arm64": "bun scripts/build.ts --target linux-arm64",
    "build:binary:darwin-x64": "bun scripts/build.ts --target darwin-x64",
    "build:binary:darwin-arm64": "bun scripts/build.ts --target darwin-arm64",
    "build:binary:all": "bash scripts/build-binaries.sh",
    "test": "bun test",
    "lint": "tsc --noEmit",
    "lgtm": "bun run packages/core/src/index.ts"
  },
  "devDependencies": {
    "bun-types": "^1.2.0",
    "typescript": "^5.6.0"
  },
  "keywords": ["cli", "tui", "developer-tools", "code-review", "productivity"],
  "author": "",
  "license": "MIT"
}
