{
  "name": "lgtm",
  "version": "0.1.0",
  "description": "👍 Looks Good To Me — dev productivity platform — a dev productivity platform with plugins",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/plugins/*"
  ],
  "bin": {
    "lgtm": "./packages/core/src/index.ts"
  },
  "scripts": {
    "dev": "bun run packages/core/src/index.ts",
    "build": "bun build packages/core/src/index.ts --outdir dist --target node --external react-devtools-core --external yoga-wasm-web",
    "build:binary": "bun build packages/core/src/index.ts --compile --outfile dist/lgtm",
    "build:binary:linux-x64": "bun build packages/core/src/index.ts --compile --target=bun-linux-x64 --outfile dist/lgtm-linux-x64",
    "build:binary:linux-arm64": "bun build packages/core/src/index.ts --compile --target=bun-linux-arm64 --outfile dist/lgtm-linux-arm64",
    "build:binary:darwin-x64": "bun build packages/core/src/index.ts --compile --target=bun-darwin-x64 --outfile dist/lgtm-darwin-x64",
    "build:binary:darwin-arm64": "bun build packages/core/src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/lgtm-darwin-arm64",
    "build:binary:all": "bash scripts/build-binaries.sh",
    "test": "bun test",
    "lint": "tsc --noEmit",
    "lgtm": "bun run packages/core/src/index.ts"
  },
  "devDependencies": {
    "bun-types": "^1.2.0",
    "typescript": "^5.6.0",
    "react-devtools-core": "file:./stubs/react-devtools-core",
    "yoga-wasm-web": "file:./stubs/yoga-wasm-web"
  },
  "keywords": ["cli", "tui", "developer-tools", "code-review", "productivity"],
  "author": "",
  "license": "MIT"
}
