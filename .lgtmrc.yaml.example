# LGTM Configuration (per-repo override)
# Place this as .lgtmrc.yaml in your repo root.
# Values here override the global config regardless of storage mode.

# Plugins
plugins:
  review:
    enabled: true
  specify:
    enabled: false
  learn:
    enabled: false

# AI settings (optional — also configurable via env vars)
ai:
  enabled: false
  # provider: openai      # openai | anthropic | ollama
  # model: gpt-4o-mini    # model name
  # baseUrl: http://localhost:11434  # for ollama

# Storage mode is set globally via ~/.lgtmrc (chosen during `lgtm init`):
#   "farm" = all lgtm data in ~/.lgtm-farm/ (one place for everything)
#   "repo" = .lgtm/ per repo (committed to git, team-shareable)
# This cannot be overridden per-repo — it's a global choice.
