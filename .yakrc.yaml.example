# Yak Configuration (per-repo override)
# Place this as .yakrc.yaml in your repo root.
# Values here override the global config regardless of storage mode.

# Plugins
plugins:
  review:
    enabled: true
  specify:
    enabled: false
  learn:
    enabled: false

# AI settings (optional — also configurable via env vars)
ai:
  enabled: false
  # provider: openai      # openai | anthropic | ollama
  # model: gpt-4o-mini    # model name
  # baseUrl: http://localhost:11434  # for ollama

# Storage mode is set globally via ~/.yakrc (chosen during `yak init`):
#   "farm" = all yak data in ~/.yak-farm/ (one place for everything)
#   "repo" = .yak/ per repo (committed to git, team-shareable)
# This cannot be overridden per-repo — it's a global choice.
